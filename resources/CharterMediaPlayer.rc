            VALUE "ProductName", "Charter Media Player\0"
            VALUE "ProductVersion", "1.0.1\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END

